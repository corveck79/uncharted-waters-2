{
  "name": "uncharter-waters-2",
  "version": "0.1.0",
  "description": "Browser-based remake of Uncharted Waters: New Horizons (大航海時代II)",
  "scripts": {
    "start": "webpack serve --mode development",
    "cypress": "cypress open",
    "lint": "eslint src/ --ext .ts --ext .tsx",
    "prettier": "prettier --write src/ tests/",
    "test": "jest",
    "test:e2e": "npm run build && (http-server build --silent & cypress run --browser chrome kill $!)",
    "test:e2e-firefox": "npm run build && (http-server build --silent & cypress run --browser firefox kill $!)",
    "test:e2e-edge": "npm run build && (http-server build --silent & cypress run --browser edge kill $!)",
    "build": "rm -rf build/ && webpack --mode production",
    "agent": "tsx src/agent/cli.ts",
    "agent:interactive": "tsx src/agent/cli.ts --interactive"
  },
  "author": "Johan Li",
  "license": "MIT",
  "babel": {
    "presets": [
      "@babel/preset-react",
      "@babel/preset-typescript",
      [
        "@babel/preset-env",
        {
          "targets": "defaults"
        }
      ]
    ],
    "plugins": [
      "@babel/plugin-transform-runtime"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.72",
    "@babel/runtime": "^7.19.4",
    "@headlessui/react": "^1.7.3",
    "@heroicons/react": "^2.0.12",
    "@openrouter/sdk": "^0.9.11",
    "dotenv": "^17.3.1",
    "eventemitter3": "^5.0.4",
    "lodash.throttle": "^4.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@babel/plugin-transform-runtime": "^7.19.1",
    "@babel/preset-env": "^7.19.4",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.8",
    "@swc/core": "^1.3.9",
    "@swc/jest": "^0.2.23",
    "@types/jest": "^29.2.0",
    "@types/lodash.throttle": "^4.1.7",
    "@types/node": "^25.4.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "autoprefixer": "^10.4.12",
    "babel-loader": "^8.2.5",
    "css-loader": "^6.7.1",
    "cypress": "^10.10.0",
    "eslint": "^8.25.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.0",
    "http-server": "^14.1.1",
    "husky": "^8.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.2.1",
    "jest-environment-jsdom": "^29.2.1",
    "jest-mock": "^29.2.1",
    "lint-staged": "^13.0.3",
    "mini-css-extract-plugin": "^2.6.1",
    "postcss": "^8.4.18",
    "postcss-loader": "^7.0.1",
    "prettier": "2.7.1",
    "react-refresh": "^0.14.0",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.1.8",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.2",
    "workbox-webpack-plugin": "^7.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
